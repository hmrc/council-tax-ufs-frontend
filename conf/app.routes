# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers                          controllers.CheckYourAnswersController.onPageLoad()

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET         /unauthorised                                controllers.UnauthorisedController.onPageLoad()

GET        /postcode-search                              controllers.PostcodeSearchController.onPageLoad(mode: Mode = NormalMode)
POST       /postcode-search                              controllers.PostcodeSearchController.onSubmit(mode: Mode = NormalMode)
GET        /changePostcodeSearch                         controllers.PostcodeSearchController.onPageLoad(mode: Mode = CheckMode)
POST       /changePostcodeSearch                         controllers.PostcodeSearchController.onSubmit(mode: Mode = CheckMode)

GET        /search-results                               controllers.SearchResultsController.show(postcode: String, page: Int ?= 1)
GET        /property/:id                                 controllers.PropertyDetailController.onPageLoad(id: String)
 


GET        /councilTaxResponsible                        controllers.CouncilTaxResponsibleController.onPageLoad(mode: Mode = NormalMode)
POST       /councilTaxResponsible                        controllers.CouncilTaxResponsibleController.onSubmit(mode: Mode = NormalMode)
GET        /changeCouncilTaxResponsible                  controllers.CouncilTaxResponsibleController.onPageLoad(mode: Mode = CheckMode)
POST       /changeCouncilTaxResponsible                  controllers.CouncilTaxResponsibleController.onSubmit(mode: Mode = CheckMode)

GET        /requestCouncilTaxBandReview                        controllers.RequestCouncilTaxBandReviewController.onPageLoad(mode: Mode = NormalMode)
POST       /requestCouncilTaxBandReview                        controllers.RequestCouncilTaxBandReviewController.onSubmit(mode: Mode = NormalMode)
GET        /changeRequestCouncilTaxBandReview                  controllers.RequestCouncilTaxBandReviewController.onPageLoad(mode: Mode = CheckMode)
POST       /changeRequestCouncilTaxBandReview                  controllers.RequestCouncilTaxBandReviewController.onSubmit(mode: Mode = CheckMode)

GET        /noPermission                       controllers.PermissionController.onPageLoad()

GET        /reasonForReview                        controllers.ReasonForReviewController.onPageLoad(mode: Mode = NormalMode)
POST       /reasonForReview                        controllers.ReasonForReviewController.onSubmit(mode: Mode = NormalMode)
GET        /changeReasonForReview                  controllers.ReasonForReviewController.onPageLoad(mode: Mode = CheckMode)
POST       /changeReasonForReview                  controllers.ReasonForReviewController.onSubmit(mode: Mode = CheckMode)

GET        /scenarioResponsible                        controllers.scenarioResponsibleController.onPageLoad(mode: Mode = NormalMode)
POST       /scenarioResponsible                        controllers.scenarioResponsibleController.onSubmit(mode: Mode = NormalMode)
GET        /changescenarioResponsible                  controllers.scenarioResponsibleController.onPageLoad(mode: Mode = CheckMode)
POST       /changescenarioResponsible                  controllers.scenarioResponsibleController.onSubmit(mode: Mode = CheckMode)

GET        /deletionOptions                        controllers.deletionOptionsController.onPageLoad(mode: Mode = NormalMode)
POST       /deletionOptions                        controllers.deletionOptionsController.onSubmit(mode: Mode = NormalMode)
GET        /changedeletionOptions                  controllers.deletionOptionsController.onPageLoad(mode: Mode = CheckMode)
POST       /changedeletionOptions                  controllers.deletionOptionsController.onSubmit(mode: Mode = CheckMode)

GET        /noticeAlteration                        controllers.noticeAlterationController.onPageLoad(mode: Mode = NormalMode)
POST       /noticeAlteration                        controllers.noticeAlterationController.onSubmit(mode: Mode = NormalMode)
GET        /changenoticeAlteration                  controllers.noticeAlterationController.onPageLoad(mode: Mode = CheckMode)
POST       /changenoticeAlteration                  controllers.noticeAlterationController.onSubmit(mode: Mode = CheckMode)
